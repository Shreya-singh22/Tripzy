# Database — SQLite for local dev, swap to postgresql:// to go live
DATABASE_URL="file:./dev.db"

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret-must-be-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-must-be-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Frontend origin for CORS
FRONTEND_URL="http://localhost:8080"

# Seed admin credentials — change before deploying
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@tripzy.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_PHONE="9999999999"
ADMIN_PINCODE="110001"
